{
  "name": "app-portfolio-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "Command center for a solo developer managing multiple AI-model-generated implementations of the same app concept.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint --max-warnings 0",
    "scanner": "node scripts/repo-scanner.mjs",
    "scan:all": "node scripts/scan-all.mjs",
    "scan:schedule": "bash scripts/scan-schedule.sh",
    "scan:scheduled": "bash scripts/scan-all-scheduled.sh",
    "chrome:watch": "bash scripts/chrome-watch.sh",
    "verify:cron-email": "node scripts/verify-cron-email.mjs",
    "verify:firestore-rules": "node scripts/verify-firestore-rules.mjs",
    "verify:send-auth": "node scripts/verify-send-auth.mjs",
    "verify:auth-domains": "node scripts/verify-auth-domains.mjs",
    "verify:prod-signin": "node scripts/verify-prod-signin.mjs",
    "verify:google-idp": "node scripts/verify-google-idp.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:launch-checklist": "node scripts/verify-launch-checklist.mjs",
    "authorize:domain": "node scripts/authorize-domain.mjs",
    "seed:winner-candidates": "node scripts/seed-winner-candidates.mjs",
    "hooks:install": "git config core.hooksPath .githooks && echo \"pre-push hook installed (git config core.hooksPath .githooks)\"",
    "hooks:install:all": "node scripts/install-push-hook.mjs --all",
    "capture:screenshots": "bash scripts/capture-screenshots.sh"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
