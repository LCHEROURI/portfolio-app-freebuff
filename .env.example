# ============================================================================
# App Portfolio Command Center — environment variables
# Copy to `.env.local` for local development. Add the same values (without the
# `NEXT_PUBLIC_` rule below) to Vercel → Project → Settings → Environment
# Variables, then redeploy.
# ============================================================================

# ─── Firebase (optional) ─────────────────────────────────────────────────────
# Enables real Authentication + Firestore (Phase 3). Without these the app
# runs in local/demo mode with a seeded workspace.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Supabase — Live Tasks + Reminders (Phase 4, Step 1) ────────────────────
# 1. Create a Supabase project, open the SQL editor, and run
#    `supabase/schema.sql` (creates public.tasks + public.reminders + public.
#    projects/versions/evaluations with RLS).
# 2. Project Settings → API: copy the Project URL and the service_role key
#    (server-only — never prefix this with NEXT_PUBLIC_).
# 3. Set NEXT_PUBLIC_LIVE_TASKS=1 so tasks/reminders call the live API routes.
# 4. Set NEXT_PUBLIC_LIVE_PROJECTS=1 so projects/versions/evaluations persist
#    to Supabase too — the automation cron evaluates these tables for the
#    project-level rules (stale, missing winner, no-next-task, …).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_LIVE_TASKS=0
NEXT_PUBLIC_LIVE_PROJECTS=0

# ─── GitHub — Live Repositories (Phase 4, Step 2) ───────────────────────────
# 1. Create a fine-grained PAT (repo read scope) → Settings → Developer
#    settings → Personal access tokens.
# 2. Set the owner + repo list (comma-separated). Defaults: LCHEROURI and the
#    active repo list below.
# 3. Set NEXT_PUBLIC_LIVE_REPOS=1.
GITHUB_TOKEN=
GITHUB_OWNER=LCHEROURI
GITHUB_REPOS=portfolio-app-freebuff,freebuff-meal,newark-websites25,prompt-vault-pro,tip-compass,reviewmaestro-production,mortgage-zip-lead-engine
NEXT_PUBLIC_LIVE_REPOS=0

# ─── Vercel — Live Deployments + health checks (Phase 4, Step 3) ────────────
# 1. Vercel → Account Settings → Tokens → create an API token.
# 2. Projects default to GITHUB_REPOS (or override with VERCEL_PROJECTS).
# 3. Set NEXT_PUBLIC_LIVE_DEPLOYMENTS=1.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECTS=
NEXT_PUBLIC_LIVE_DEPLOYMENTS=0

# ─── Vercel dashboard deep-link (optional) ───────────────────────────────────
# Each integration's "Open Vercel project env settings" link in the setup
# checklist points at the project's Environment Variables page. The defaults
# match this repo's own Vercel project — only override when deploying a fork
# under a different team or project slug.
NEXT_PUBLIC_VERCEL_TEAM_SLUG=laredj-chehrouris-projects
NEXT_PUBLIC_VERCEL_PROJECT_SLUG=portfolio-app-freebuff

# ─── Firebase Hosting — Deployments feed (optional) ─────────────────────────
# When set, /api/deployments also pulls the latest Firebase Hosting release per
# site and health-checks https://{site}.web.app. Get a token with:
#   npx firebase login:ci
FIREBASE_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_SITES=


# ─── Automation Engine — cron + daily/weekly report emails (Phase 5) ────────
# A Vercel Cron job (vercel.json) calls /api/cron/reports every day at 07:00 UTC.
# It evaluates the 14 automation rules against live data and emails the report
# (daily every run; weekly when the UTC weekday matches REPORT_WEEKLY_DAY).
#
# 1. CRON_SECRET — any long random string. Vercel Cron automatically sends it
#    as `Authorization: Bearer <CRON_SECRET>`; the route rejects requests that
#    don't carry it. (Vercel → Project → Settings → Environment Variables.)
# 2. RESEND_API_KEY — from https://resend.com (free tier covers daily emails).
# 3. REPORT_EMAIL — inbox that receives the reports.
#
# Optional:
#   REPORT_FROM         sender (default: Command Center <onboarding@resend.dev>)
#   REPORT_OWNER_ID     whose data is reported (default demo-user; set to your
#                       Firebase uid when Firebase auth is wired)
#   REPORT_WEEKLY_DAY   0-6 UTC weekday for the weekly report (default 1 = Mon)
#   REPORT_STALE_DAYS   stale threshold used by the rules (default 7)
#   REPORT_TIME         HH:mm label used in report titles (default 07:00)
#   REPORT_NAME         sender name shown in the email (default "Command Center")
#   REPORT_TIMEZONE     timezone label (default UTC)
CRON_SECRET=
RESEND_API_KEY=
REPORT_EMAIL=
REPORT_FROM=
REPORT_OWNER_ID=demo-user
REPORT_WEEKLY_DAY=1
REPORT_STALE_DAYS=7
REPORT_TIME=07:00
REPORT_NAME=Command Center
REPORT_TIMEZONE=UTC

# ─── OpenRouter — AI report summaries (Phase 6) ──────────────────────────────────────────────────────
# Optional. When OPENROUTER_API_KEY is set, generated reports (Reports page and
# the daily/weekly cron emails) include a short AI "executive summary" paragraph
# written by the model in OPENROUTER_MODEL. Without the key, or when the call
# fails, the deterministic report text is sent unchanged — AI is an enhancement,
# never a blocker.
#
# 1. Create a key at https://openrouter.ai/keys (server-only — never prefix
#    with NEXT_PUBLIC_).
# 2. OPENROUTER_MODEL: any model id OpenRouter serves. Default is
#    deepseek/deepseek-chat. Swap freely to A/B the very models you track here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Dev only: status-flip simulator ─────────────────────────────────────────
# NEXT_PUBLIC_ENABLE_SIMULATIONS=1 shows a "Simulate status flip" button on
# the Integrations page (and arms the same flip in the sidebar widget). While
# armed, /api/status reports GitHub as down (503, 2400ms) so the what-changed
# badge + tooltip can be demonstrated live without waiting for a real outage.
# Leave unset or 0 in production.
NEXT_PUBLIC_ENABLE_SIMULATIONS=0
