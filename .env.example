# ─── Optional: Firebase (Phase 3) ────────────────────────────────────────────
# Without these, the Command Center runs in Demo Mode:
#   - seeded demo data, persisted to localStorage in this browser
#   - no sign-in required, everything works offline
#
# With these set, the app switches to real Authentication + Firestore:
#   - a sign-in gate appears (email/password or Google)
#   - every user's data is isolated per account and synced to Firestore
#   - local demo data can be imported into your account on first sign-in
#
# Create a Firebase project, enable Authentication (Email/Password + Google)
# and Firestore, then paste the web-app config values here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Deploy the security rules in firestore.rules so reads/writes are
# scoped to the signed-in user:
#   npx firebase deploy --only firestore:rules
