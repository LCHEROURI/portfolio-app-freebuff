[TEMPLATE]
# ============================================================================
# App Portfolio Command Center — environment variables
# Copy to `.env.local` for local development. Add the same values (without the
# `NEXT_PUBLIC_` rule below) to Vercel → Project → Settings → Environment
# Variables, then redeploy.
# ============================================================================

# ─── Firebase (optional) ─────────────────────────────────────────────────────
# Enables real Authentication + Firestore (Phase 3). Without these the app
# runs in local/demo mode with a seeded workspace.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Public demo deployment ───────────────────────────────────────────────────
# NEXT_PUBLIC_DEMO_OVERRIDE=1 forces demo mode even when the Firebase vars
# above are present: no sign-in gate, seeded localStorage data, and the live
# routes trust x-app-user again. Used on the public demo build so the live link
# serves the app exactly as the README's "No sign-up needed" promise describes.
# Leave unset (or 0) on environments that should behave as a real account.
NEXT_PUBLIC_DEMO_OVERRIDE=0
# ─── Firestore — server-side data store for the automation engine ─────────
# The app's single data store is Firestore: the client writes projects,
# versions, evaluations, tasks, and activity through the Firebase SDK, and the
# automation cron reads the SAME documents server-side via a service account.
# No separate database to provision — no schema to push.
# 1. Console → Project settings → Service accounts → Generate new private key.
#    Grant the account Cloud Datastore / Firestore read access (roles/
#    datastore.user).
# 2. Set FIREBASE_SERVICE_ACCOUNT to the raw JSON (server-only — never prefix
#    with NEXT_PUBLIC_). FIREBASE_SERVICE_ACCOUNT_PATH (a file path) works for
#    local dev.
# 3. The project id comes from NEXT_PUBLIC_FIREBASE_PROJECT_ID below.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── Verification sandbox (second Spark project) ────────────────────────────
# The firestore-rules gate probes THIS project instead of production so
# verification never touches the production Firestore read quota. Create it
# once (portfolio-app-freebuff-verify), enable Auth + Firestore in the
# console, deploy the same firestore.rules to both projects (npm run
# deploy:rules), and set both vars in .env.local, Vercel prod, and GitHub
# secrets. Absent → the gate falls back to probing production with a notice.
VERIFY_FIREBASE_PROJECT_ID=
VERIFY_FIREBASE_WEB_API_KEY=

# ─── GitHub — Live Repositories (Phase 4, Step 2) ───────────────────────────
# 1. Create a fine-grained PAT (repo read scope) → Settings → Developer
#    settings → Personal access tokens.
# 2. Set the owner + repo list (comma-separated). Defaults: LCHEROURI and the
#    active repo list below.
# 3. Set NEXT_PUBLIC_LIVE_REPOS=1.
GITHUB_TOKEN=
GITHUB_OWNER=LCHEROURI
GITHUB_REPOS=portfolio-app-freebuff,freebuff-meal,newark-websites25,prompt-vault-pro,tip-compass,reviewmaestro-production,mortgage-zip-lead-engine
NEXT_PUBLIC_LIVE_REPOS=0

# ─── Vercel — Live Deployments + health checks (Phase 4, Step 3) ────────────
# 1. Vercel → Account Settings → Tokens → create an API token.
# 2. Projects default to GITHUB_REPOS (or override with VERCEL_PROJECTS).
# 3. Set NEXT_PUBLIC_LIVE_DEPLOYMENTS=1.
#    IMPORTANT: this is a BUILD-TIME flag — it is inlined from the env of the
#    build Vercel runs, so setting it only in .env.local does NOT flip the
#    deployed UI. Set it in Vercel Production env too (e.g. `vercel env add
#    NEXT_PUBLIC_LIVE_DEPLOYMENTS production`) and redeploy. This exact gap
#    once hid the live feed: /api/deployments returned real rows while the
#    page still rendered demo data, because the deployed copy was off.
# VERCEL_TEAM_ID: set for team projects (Settings → Teams → your team → the
# team_… id shown in API responses) so the feed's /v6/deployments query
# resolves the project slug.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECTS=
NEXT_PUBLIC_LIVE_DEPLOYMENTS=0

# ─── Vercel dashboard deep-link (optional) ───────────────────────────────────
# Each integration's "Open Vercel project env settings" link in the setup
# checklist points at the project's Environment Variables page. The defaults
# match this repo's own Vercel project — only override when deploying a fork
# under a different team or project slug.
NEXT_PUBLIC_VERCEL_TEAM_SLUG=laredj-chehrouris-projects
NEXT_PUBLIC_VERCEL_PROJECT_SLUG=portfolio-app-freebuff

# ─── Firebase Hosting — Deployments feed (optional) ─────────────────────────
# When set, /api/deployments also pulls the latest Firebase Hosting release per
# site and health-checks https://{site}.web.app. The feed mints a per-request
# token from FIREBASE_SERVICE_ACCOUNT (durable, no expiry); a static
# FIREBASE_TOKEN (npx firebase login:ci) is still supported as a fallback.
FIREBASE_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_SITES=


# ─── Automation Engine — cron report generation (Phase 5) ────────
# A Vercel Cron job (vercel.json) calls /api/cron/reports every day at 07:00 UTC.
# It evaluates the 14 automation rules against live data and composes the
# report for the in-app Reports page and the verification suite. Nothing is
# emailed — no sender key, inbox, or domain is needed.
#
# 1. CRON_SECRET — any long random string. Vercel Cron automatically sends it
#    as `Authorization: Bearer <CRON_SECRET>`; the route rejects requests that
#    don't carry it. (Vercel → Project → Settings → Environment Variables.)
#
# Optional:
#   REPORT_OWNER_ID     whose data is reported (default demo-user; set to your
#                       Firebase uid when Firebase auth is wired)
#   REPORT_WEEKLY_DAY   0-6 UTC weekday for the weekly report (default 1 = Mon)
#   REPORT_MONTHLY_DAY  1-31 UTC day-of-month for the monthly report (default 1;
#                       values past a short month's last day simply skip it)
#   REPORT_STALE_DAYS   stale threshold used by the rules (default 7)
#   REPORT_TIME         HH:mm label used in report titles (default 07:00)
#   REPORT_NAME         label used in report titles (default "Command Center")
#   REPORT_TIMEZONE     timezone label (default UTC)
CRON_SECRET=
REPORT_OWNER_ID=demo-user
REPORT_WEEKLY_DAY=1
REPORT_MONTHLY_DAY=1
REPORT_STALE_DAYS=7
REPORT_TIME=07:00
REPORT_NAME=Command Center
REPORT_TIMEZONE=UTC

# ─── OpenRouter — AI report summaries (Phase 6) ──────────────────────────────────────────────────────
# Optional. When OPENROUTER_API_KEY is set, generated reports (Reports page and
# the daily/weekly cron reports) include a short AI "executive summary" paragraph
# written by the model in OPENROUTER_MODEL. Without the key, or when the call
# fails, the deterministic report text is sent unchanged — AI is an enhancement,
# never a blocker.
#
# 1. Create a key at https://openrouter.ai/keys (server-only — never prefix
#    with NEXT_PUBLIC_).
# 2. OPENROUTER_MODEL: any model id OpenRouter serves. Default is
#    deepseek/deepseek-chat. Swap freely to A/B the very models you track here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Dev only: status-flip simulator ─────────────────────────────────────────
# NEXT_PUBLIC_ENABLE_SIMULATIONS=1 shows a "Simulate status flip" button on
# the Integrations page (and arms the same flip in the sidebar widget). While
# armed, /api/status reports GitHub as down (503, 2400ms) so the what-changed
# badge + tooltip can be demonstrated live without waiting for a real outage.
# Leave unset or 0 in production.
NEXT_PUBLIC_ENABLE_SIMULATIONS=0

# ── AI briefings on the Command Center ───────────────────────────────────────
# NEXT_PUBLIC_ENABLE_AI_BRIEFINGS=1 auto-generates the "why these three matter
# today" narration when the dashboard loads (no click needed), showing a
# skeleton shimmer while it generates. Leave unset or 0 to keep the manual
# AI Explain button only. Requires OPENROUTER_API_KEY; falls back to the
# rule-based list when unset or the call fails.
NEXT_PUBLIC_ENABLE_AI_BRIEFINGS=0
