#!/usr/bin/env bash
# ============================================================================
# .githooks/pre-push — run the full post-deploy verification suite before
# pushing to main, so sign-in, Firestore rules, authorized-domains, and cron
# email regressions are all caught locally instead of waiting for CI.
# Enabled with:
#
#     npm run hooks:install      (git config core.hooksPath .githooks)
#     node scripts/install-push-hook.mjs <path>   (shared installer, any repo)
#
# Runs, in order, each gated on what it needs:
#   1. scripts/verify-auth-domains.mjs   (needs FIREBASE_WEB_API_KEY)
#   2. scripts/verify-cron-email.mjs     (needs CRON_SECRET)
#   3. scripts/verify-prod-signin.mjs    (needs FIREBASE_WEB_API_KEY + Chrome)
# A check that cannot run (missing key / secret / Chrome / script file) is
# skipped with a notice, not a failure — so machines without the deployment
# secrets, and repos without the verify suite, are never blocked. Any check
# that DOES run and fails aborts the push.
#
# Timebox: every verifier gets a 90-second budget (perl alarm — no `timeout`
# binary required). A run that exceeds the budget is killed and the push aborts
# with a 'too slow, run CI' message, so slow OpenRouter/Chrome runs can never
# stall a routine push.
# SKIP_VERIFY_SIGNIN=1 skips everything.
# ============================================================================
set -euo pipefail

if [ "${SKIP_VERIFY_SIGNIN:-0}" = "1" ]; then
  echo "pre-push: SKIP_VERIFY_SIGNIN=1 — skipping verification"
  exit 0
fi

# Only guard pushes that touch main.
PUSHES_TO_MAIN=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && PUSHES_TO_MAIN=1
done
if [ "$PUSHES_TO_MAIN" != "1" ]; then
  exit 0
fi

# Resolve deployment secrets from env, then .env.local (never printed).
read_env() { # $1=var name -> echoes value or empty
  local v
  v="${!1:-}"
  if [ -z "$v" ] && [ -f .env.local ]; then
    v="$(grep -m1 "^$1=" .env.local | cut -d= -f2- | tr -d '"' || true)"
  fi
  printf '%s' "$v"
}

# ─── 90s-timeboxed verifier runner ──────────────────────────────────────────
# $1 = friendly label, $2 = script path (relative to repo root). Aborts the
# push on failure OR on timeout (perl alarm delivers SIGALRM -> exit 142).
run_verify() {
  local label="$1" script="$2"
  echo "pre-push: verifying $label…"
  if perl -e 'alarm shift; exec @ARGV' 90 node "$script"; then
    echo "pre-push: $label passed ✓"
  else
    local rc=$?
    if [ "$rc" -eq 142 ]; then
      echo "pre-push: $label exceeded 90s — too slow, run CI instead (SKIP_VERIFY_SIGNIN=1 to override)" >&2
    else
      echo "pre-push: $label FAILED — fix before pushing (SKIP_VERIFY_SIGNIN=1 to override)" >&2
    fi
    exit 1
  fi
}

KEY="$(read_env FIREBASE_WEB_API_KEY)"
CRON="$(read_env CRON_SECRET)"

# ── 1. Authorized-domains gate (fast, no Chrome) ───────────────────────────
if [ -n "$KEY" ] && [ -f scripts/verify-auth-domains.mjs ]; then
  run_verify "production authorized domains" scripts/verify-auth-domains.mjs
else
  [ -f scripts/verify-auth-domains.mjs ] || echo "pre-push: verify suite not present — skipping authorized-domains proof"
  [ -n "$KEY" ] || echo "pre-push: FIREBASE_WEB_API_KEY not set — skipping authorized-domains proof"
fi

# ── 2. Cron-email gate (needs CRON_SECRET) ─────────────────────────────────
if [ -n "$CRON" ] && [ -f scripts/verify-cron-email.mjs ]; then
  run_verify "deployed cron-email bodies" scripts/verify-cron-email.mjs
else
  [ -f scripts/verify-cron-email.mjs ] || echo "pre-push: verify suite not present — skipping cron-email proof"
  [ -n "$CRON" ] || echo "pre-push: CRON_SECRET not set — skipping cron-email proof"
fi

# ── 3. Sign-in + Firestore sync gate (needs Chrome) ─────────────────────────
if [ -n "$KEY" ] && [ -f scripts/verify-prod-signin.mjs ]; then
  CHROME="${CHROME_PATH:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
  if [ -x "$CHROME" ]; then
    run_verify "production sign-in + Firestore sync" scripts/verify-prod-signin.mjs
  else
    echo "pre-push: Chrome not found — skipping sign-in proof"
  fi
else
  [ -f scripts/verify-prod-signin.mjs ] || echo "pre-push: verify suite not present — skipping sign-in proof"
  [ -n "$KEY" ] || echo "pre-push: FIREBASE_WEB_API_KEY not set — skipping sign-in proof"
fi

echo "pre-push: all applicable checks passed ✓"
