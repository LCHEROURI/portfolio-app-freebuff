#!/usr/bin/env bash
# ============================================================================
# .githooks/pre-push — run the full post-deploy verification suite before
# pushing to main, so sign-in, Firestore rules, authorized-domains, and cron
# report regressions are all caught locally instead of waiting for CI.
# Enabled with:
#
#     npm run hooks:install      (git config core.hooksPath .githooks)
#     node scripts/install-push-hook.mjs <path>   (shared installer, any repo)
#
# Runs, in order, each gated on what it needs:
#   0. scripts/verify-deployed-hash.mjs  (needs VERCEL_TOKEN — resolves the
#      canonical production URL via the v13 by-host lookup and asserts it
#      serves the last PUSHED commit; a bare fallback needs no team scope)
#   0.5 scripts/verify-token-health.mjs  (needs VERCEL_TOKEN — cheap, no Chrome)
#   0.6 scripts/lint-import-surface.mjs  (no secrets, pure static, near-instant)
#   0.6b scripts/lint-dead-words.mjs      (dead-feature phrasing — no secrets, pure static)
#   0.6c scripts/capture-docs.mjs --check (needs Chrome — renders README Handoff +
#      launch.md §4 and FAILS if the committed onboarding PNGs would change)
#   0.6d scripts/verify-review-sheet.mjs --check (needs KEY + Chrome — re-runs the
#      review-sheet capture deterministically and FAILS if the committed pair
#      would change)
#   0.7 scripts/verify-vercel-env.mjs    (needs VERCEL_TOKEN + vercel CLI — pulls prod
#                                          env and asserts it matches .env.local)
#   1. scripts/verify-auth-domains.mjs   (needs FIREBASE_WEB_API_KEY)
#   2. scripts/verify-cron-reports.mjs  (needs CRON_SECRET)
#   3. scripts/verify-prod-signin.mjs    (needs FIREBASE_WEB_API_KEY + Chrome)
#   3b. scripts/verify-profile-no-email.mjs (needs FIREBASE_WEB_API_KEY + Chrome)
#   4. scripts/ship-ready.mjs            (FINAL capstone: clean tree + FULL
#                                          verify:all suite — 20-min budget,
#                                          well beyond the 90s per-verifier)
# A check that cannot run (missing key / secret / Chrome / script file) is
# skipped with a notice, not a failure — so machines without the deployment
# secrets, and repos without the verify suite, are never blocked. Any check
# that DOES run and fails aborts the push.
#
# Timebox: every verifier gets a 90-second budget (perl alarm — no `timeout`
# binary required). A run that exceeds the budget is killed and the push aborts
# with a 'too slow, run CI' message, so slow OpenRouter/Chrome runs can never
# stall a routine push.
# SKIP_VERIFY_SIGNIN=1 skips everything.
# ============================================================================
set -euo pipefail

if [ "${SKIP_VERIFY_SIGNIN:-0}" = "1" ]; then
  echo "pre-push: SKIP_VERIFY_SIGNIN=1 — skipping verification"
  exit 0
fi

# Only guard pushes that touch main. Capture the remote tip (the last commit
# already on origin/main) so the deployed-hash gate can assert production is
# actually serving it — closing the infer-vs-verify gap: a push that "succeeded"
# but never deployed is caught before the next push piles on top.
PUSHES_TO_MAIN=0
REMOTE_MAIN_SHA=""
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    PUSHES_TO_MAIN=1
    REMOTE_MAIN_SHA="$_remote_sha"
  fi
done
if [ "$PUSHES_TO_MAIN" != "1" ]; then
  exit 0
fi

# ─── 0. Chrome health (best-effort, before any verifier runs) ──────────────
# A GUI Chrome that died uncleanly leaves stale Singleton locks and refuses to
# open until they are cleared. The verifiers use their own headless profiles,
# so they would still pass — but the user's browser would stay silently broken
# on every push. chrome-revive.sh sweeps leftover headless instances, clears
# the stale locks, and relaunches Chrome; it is an instant no-op when Chrome is
# healthy (it detects the running windowed process and exits 0 immediately).
# Timeboxed to 15s so a slow relaunch can never stall a routine push. Never
# blocks the push: if revival fails, the verifiers still run and decide the
# outcome.
CHROME_BIN="${CHROME_PATH:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
if [ -x "$CHROME_BIN" ] && [ -f scripts/chrome-revive.sh ]; then
  echo "pre-push: checking Chrome health…"
  if perl -e 'alarm shift; exec @ARGV' 15 bash scripts/chrome-revive.sh; then
    echo "pre-push: Chrome healthy ✓"
  else
    echo "pre-push: chrome-revive did not finish cleanly (non-fatal, verifiers will judge)" >&2
  fi
else
  echo "pre-push: chrome-revive.sh not available — skipping Chrome health check"
fi

# Resolve deployment secrets from env, then .env.local (never printed).
read_env() { # $1=var name -> echoes value or empty
  local v
  v="${!1:-}"
  if [ -z "$v" ] && [ -f .env.local ]; then
    v="$(grep -m1 "^$1=" .env.local | cut -d= -f2- | tr -d '"' || true)"
  fi
  printf '%s' "$v"
}

# ─── Timeboxed verifier runners ─────────────────────────────────────────────
# timebox <budget> <command...> — run <command> under a perl alarm (SIGALRM
# delivers exit 142; no `timeout` binary required). The single source of the
# timebox contract: every verifier invocation below goes through it.
timebox() {
  perl -e 'alarm shift; exec @ARGV' "$@"
}

# run_verify <label> <script> [args...] — the plain, non-retrying verifier for
# the cheap, deterministic gates (lints, token health, env drift, authorized
# domains, cron reports): a fixed 90s timebox that aborts the push on failure
# OR on timeout.
run_verify() {
  local label="$1" script="$2"
  shift 2  # remaining args (if any) are forwarded to the script
  echo "pre-push: verifying $label…"
  if timebox 90 node "$script" "$@"; then
    echo "pre-push: $label passed ✓"
  else
    local rc=$?
    if [ "$rc" -eq 142 ]; then
      echo "pre-push: $label exceeded 90s — too slow, run CI instead (SKIP_VERIFY_SIGNIN=1 to override)" >&2
    else
      echo "pre-push: $label FAILED — fix before pushing (SKIP_VERIFY_SIGNIN=1 to override)" >&2
    fi
    exit 1
  fi
}

# run_with_retry <budget> <label> <fail_msg> <transient> <command...> — the
# shared wrapper for gates that drive the LIVE app or headless Chrome, where
# transient first-attempt failures (sign-in network blips, slow AI
# round-trips, Chrome startup) have been observed. $1 = budget (seconds), $2 =
# friendly label, $3 = failure message printed when BOTH attempts fail, $4 =
# transient descriptor for the retry notice; the remaining args are the
# command to run (script + args). A 142 (alarm timeout) aborts immediately —
# no point retrying a run that already used its whole budget. An optional
# FATAL_RC (+ FATAL_MSG) env makes that exit code abort immediately WITHOUT
# retry (deployed-hash's revoked-token rc=2: waiting cannot revive a revoked
# token). Any other failure sleeps 30s and re-runs the SAME command once; a
# pass on retry prints '(on retry)', a second failure prints $3 and aborts.
# Never returns nonzero: success returns 0, every failure path exits — so it
# is safe to call as a bare statement under `set -e`.
run_with_retry() {
  local budget="$1" label="$2" fail_msg="$3" transient="$4"
  shift 4
  echo "pre-push: verifying $label…"
  if timebox "$budget" "$@"; then
    echo "pre-push: $label passed ✓"
    return 0
  else
    # CRITICAL: capture $? INSIDE the else, not after a no-else `if` — a bare
    # `if cmd; then return; fi; local rc=$?` always sees rc=0 because the if
    # statement itself exits 0 on a false condition. Capturing in the else
    # (the pre-refactor idiom) preserves the real exit code so the 142-timeout
    # and FATAL_RC branches below can fire.
    local rc=$?
    if [ "$rc" -eq 142 ]; then
      echo "pre-push: $label exceeded ${budget}s — too slow, run CI instead (SKIP_VERIFY_SIGNIN=1 to override)" >&2
      exit 1
    fi
    if [ -n "${FATAL_RC:-}" ] && [ "$rc" -eq "$FATAL_RC" ]; then
      echo "pre-push: $label aborted — ${FATAL_MSG:-fatal rc=$rc} (SKIP_VERIFY_SIGNIN=1 to override)" >&2
      exit 1
    fi
    echo "pre-push: $label failed (rc=$rc) — waiting 30s and retrying once (transient $transient?)…" >&2
    sleep 30
    if timebox "$budget" "$@"; then
      echo "pre-push: $label passed ✓ (on retry)"
      return 0
    else
      local rc2=$?
      if [ "$rc2" -eq 142 ]; then
        echo "pre-push: $label exceeded ${budget}s — too slow, run CI instead (SKIP_VERIFY_SIGNIN=1 to override)" >&2
      elif [ -n "${FATAL_RC:-}" ] && [ "$rc2" -eq "$FATAL_RC" ]; then
        echo "pre-push: $label aborted — ${FATAL_MSG:-fatal rc=$rc2} (SKIP_VERIFY_SIGNIN=1 to override)" >&2
      else
        echo "pre-push: $label FAILED — $fail_msg (SKIP_VERIFY_SIGNIN=1 to override)" >&2
      fi
      exit 1
    fi
  fi
}

KEY="$(read_env FIREBASE_WEB_API_KEY)"
# The web API key is commonly stored as NEXT_PUBLIC_FIREBASE_API_KEY in
# .env.local (that is the name the verify scripts themselves fall back to).
# Mirror that fallback here so the hook's key gates don't skip a proof the
# scripts could actually run.
if [ -z "$KEY" ]; then
  KEY="$(read_env NEXT_PUBLIC_FIREBASE_API_KEY)"
fi
CRON="$(read_env CRON_SECRET)"
VERCEL="$(read_env VERCEL_TOKEN)"
# The canonical production URL — the alias whose routing the drift watch
# asserts matches the deployment-specific URL verified by the hash gate.
PRODUCTION_URL="https://portfolio-app-freebuff.vercel.app"

# ── 0. Deployed-hash gate (needs VERCEL_TOKEN; asserts the LAST pushed ──────
#    commit is what production is actually serving). The commit being pushed
#    right now cannot be live yet — Vercel deploys after the push lands — so
#    the meaningful assertion is against the remote tip (origin/main), the
#    commit the previous push claimed to ship. If that deploy silently failed
#    or is still in progress, this blocks the next push with a clear message
#    instead of letting the gap grow.
# Skips (with a notice) when: the token is unavailable, the remote tip is all
# zeros (first push to an empty main — nothing to have deployed yet), or the
# script file is missing.
if [ -f scripts/verify-deployed-hash.mjs ]; then
  if [ -z "$VERCEL" ]; then
    echo "pre-push: VERCEL_TOKEN not set — skipping deployed-hash proof"
  elif [ "${REMOTE_MAIN_SHA//0/}" = "" ]; then
    echo "pre-push: first push to main (no previous remote commit) — skipping deployed-hash proof"
  else
    # The hash gate resolves the CANONICAL production URL directly via the v13
    # by-host lookup (with a bare unscoped fallback) and asserts it serves the
    # pushed commit. Targeting the canonical URL also subsumes the old
    # alias-routing drift watch: if the alias pointed at an older/newer
    # deployment, --expect would fail here directly — and this path needs NO
    # team-scope resolution, so a team-scoped token or a missing defaultTeamId
    # can never send it down the v6 list branch (the exact failure the gate
    # used to hit). CI's verify-deployed-hash.yml still runs the
    # deployment-specific-vs-canonical drift watch, where both URLs are known.
    # Note: right after a deploy the alias can TRANSIENTLY lag propagation
    # (tens of seconds), so run_with_retry retries once after a 30s backoff —
    # a transient lag clears on the retry and the push proceeds, a genuine
    # mismatch fails both attempts and aborts. rc=2 (Vercel flagged
    # invalidToken:true) is FATAL: waiting cannot revive a revoked token, so
    # the gate aborts with the paste-a-fresh-token message instead of the
    # generic deploy-failed error.
    FATAL_RC=2 FATAL_MSG="VERCEL_TOKEN is invalid or revoked — paste a fresh token from https://vercel.com/account/tokens into .env.local, then re-push" \
    run_with_retry 90 "production deployed-hash matches origin/main (${REMOTE_MAIN_SHA:0:12}…)" \
      "production is NOT serving the last pushed commit — the deploy may have failed, is still in progress, or the canonical alias routes elsewhere. Fix or wait, then re-push" \
      "alias propagation" \
      node scripts/verify-deployed-hash.mjs --url "$PRODUCTION_URL" --expect "$REMOTE_MAIN_SHA"
  fi
else
  echo "pre-push: verify suite not present — skipping deployed-hash proof"
fi

# ── 0.5 Token-health gate (needs VERCEL_TOKEN; cheap, no Chrome) ───────────
# Proves the stored VERCEL_TOKEN is still alive and reports its name + expiry,
# so a revoked or expiring credential is caught before the deployed-hash gate
# (or a deploy) fails on it. Same rc=2 contract as the hash gate: an invalid
# token aborts the push with the paste-a-fresh-token guidance.
if [ -n "$VERCEL" ] && [ -f scripts/verify-token-health.mjs ]; then
  run_verify "Vercel token health" scripts/verify-token-health.mjs
else
  [ -f scripts/verify-token-health.mjs ] || echo "pre-push: verify suite not present — skipping token-health proof"
  [ -n "$VERCEL" ] || echo "pre-push: VERCEL_TOKEN not set — skipping token-health proof"
fi

# ── 0.6 Import-surface lint gate (no secrets, pure static, near-instant) ────
# Fails the push if any verify script or test re-exports an imported symbol it
# never uses (the nit the /check review caught) or carries an unused import.
# No secrets and no network, so it always runs when the script file is present
# — a reintroduced re-export is caught locally at push time, not just in CI's
# lint step.
if [ -f scripts/lint-import-surface.mjs ]; then
  run_verify "import-surface lint" scripts/lint-import-surface.mjs
else
  echo "pre-push: lint-import-surface.mjs not present — skipping import-surface lint"
fi

# ── 0.6b Dead-feature lint gate (no secrets, pure static, near-instant) ──────
# Fails the push if any source file, doc, or config comment reintroduces the
# report-email phrasing the emailed-report removal swept away (cron-email,
# emailed reports, email body, email preview, emails you/daily/weekly) or a
# removed integration name / env identifier (data store, delivery sender). The
# composed reports feed the in-app Reports page; nothing is emailed. Same
# always-run contract as the import-surface gate.
if [ -f scripts/lint-dead-words.mjs ]; then
  run_verify "dead-word lint" scripts/lint-dead-words.mjs
else
  echo "pre-push: lint-dead-words.mjs not present — skipping dead-word lint"
fi

# ── 0.6c Onboarding-docs render diff gate (needs Chrome, no secrets) ────────
# Renders the README Handoff section and launch.md §4 to fresh PNGs in a temp
# dir and byte-compares them with the committed screenshots/docs-*.png. A doc
# edit that alters the onboarding visuals makes the committed PNGs stale; this
# gate fails the push with 'run npm run capture:docs and commit' guidance
# instead of shipping a gallery whose onboarding pictures no longer match the
# docs. Skips with a notice when Chrome is missing (same contract as gates
# 3/3b).
if [ -f scripts/capture-docs.mjs ]; then
  CHROME="${CHROME_PATH:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
  if [ -x "$CHROME" ]; then
    # The docs render boots headless Chrome and may hit transient startup
    # failures, so run_with_retry retries ONCE after a 30s backoff before
    # failing the push — a transient clears on the retry, a genuinely stale
    # PNG pair fails both attempts and aborts (mirroring the deployed-hash
    # gate's retry).
    run_with_retry 90 "onboarding-docs render diff" \
      "run npm run capture:docs and commit" \
      "Chrome failure" \
      node scripts/capture-docs.mjs --check
  else
    echo "pre-push: Chrome not found — skipping onboarding-docs render diff"
  fi
else
  echo "pre-push: capture-docs.mjs not present — skipping onboarding-docs render diff"
fi

# ── 0.6d Review-sheet byte gate (needs KEY + Chrome) ───────────────────────
# Re-runs the review-sheet driver in deterministic capture mode (--check pins
# the AI note and winner so the renders are byte-stable across runs) and
# byte-compares the pair against the committed screenshots/review-sheet-*.png.
# A deployed-app change that alters the review-sheet visuals makes the
# committed pair stale; this gate fails the push with re-capture-and-commit
# guidance instead of shipping a gallery whose print-all pictures no longer
# match. Skips with a notice when Chrome or the web API key is missing.
# Timeboxed separately (420s) because the driver drives the LIVE app with two
# AI round-trips — far beyond run_verify's 90s budget (same treatment as the
# 1200s ship:ready capstone).
if [ -n "$KEY" ] && [ -f scripts/verify-review-sheet.mjs ]; then
  CHROME="${CHROME_PATH:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
  if [ -x "$CHROME" ]; then
    # The driver drives the LIVE app: transient failures (sign-in network
    # blips, a slow AI round-trip, an interception that did not attach on the
    # first run) have been observed, so run_with_retry retries ONCE after a
    # 30s backoff before failing the push — a transient clears on the retry,
    # a genuine stale pair fails both attempts and aborts.
    run_with_retry 420 "review-sheet byte gate (deterministic capture)" \
      "re-capture and commit the PNGs" \
      "live-app failure" \
      node scripts/verify-review-sheet.mjs --check --out /tmp/review-sheet-bytecheck
  else
    echo "pre-push: Chrome not found — skipping review-sheet byte gate"
  fi
else
  [ -f scripts/verify-review-sheet.mjs ] || echo "pre-push: verify suite not present — skipping review-sheet byte gate"
  [ -n "$KEY" ] || echo "pre-push: FIREBASE_WEB_API_KEY not set — skipping review-sheet byte gate"
fi

# ── 0.7 Vercel-env drift gate (needs VERCEL_TOKEN + vercel CLI) ───────────
# Pulls Vercel's production env and asserts every .env.local key exists there
# with an identical value (report shows names + value lengths only — never the
# secrets), so the .env.local ↔ Vercel secret stores can never silently drift
# again (they did: REPORT_OWNER_ID held 'demo-user' in prod while .env.local
# carried the real uid). Also classifies GitHub CI-only secrets as expected,
# not drift. Same rc=2 contract as the other Vercel gates: an invalid token
# aborts the push with the paste-a-fresh-token guidance.
if [ -n "$VERCEL" ] && [ -f scripts/verify-vercel-env.mjs ]; then
  if command -v vercel >/dev/null 2>&1 || command -v npx >/dev/null 2>&1; then
    run_verify "Vercel prod env vs .env.local" scripts/verify-vercel-env.mjs
  else
    echo "pre-push: vercel CLI not found — skipping vercel-env proof"
  fi
else
  [ -f scripts/verify-vercel-env.mjs ] || echo "pre-push: verify suite not present — skipping vercel-env proof"
  [ -n "$VERCEL" ] || echo "pre-push: VERCEL_TOKEN not set — skipping vercel-env proof"
fi

# ── 1. Authorized-domains gate (fast, no Chrome) ───────────────────────────
if [ -n "$KEY" ] && [ -f scripts/verify-auth-domains.mjs ]; then
  run_verify "production authorized domains" scripts/verify-auth-domains.mjs
else
  [ -f scripts/verify-auth-domains.mjs ] || echo "pre-push: verify suite not present — skipping authorized-domains proof"
  [ -n "$KEY" ] || echo "pre-push: FIREBASE_WEB_API_KEY not set — skipping authorized-domains proof"
fi

# ── 2. Cron-reports gate (needs CRON_SECRET) ────────────────────────────────
if [ -n "$CRON" ] && [ -f scripts/verify-cron-reports.mjs ]; then
  run_verify "deployed cron report bodies" scripts/verify-cron-reports.mjs
else
  [ -f scripts/verify-cron-reports.mjs ] || echo "pre-push: verify suite not present — skipping cron-reports proof"
  [ -n "$CRON" ] || echo "pre-push: CRON_SECRET not set — skipping cron-reports proof"
fi

# ── 3. Sign-in + Firestore sync gate (needs Chrome) ─────────────────────────
if [ -n "$KEY" ] && [ -f scripts/verify-prod-signin.mjs ]; then
  CHROME="${CHROME_PATH:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
  if [ -x "$CHROME" ]; then
    # The sign-in proof drives the LIVE app: transient first-attempt failures
    # (auth/network-request-failed, a slow Firestore sync) have been observed,
    # so run_with_retry retries ONCE after a 30s backoff before failing the
    # push — a transient clears on the retry, a genuine regression fails both
    # attempts and aborts.
    run_with_retry 90 "production sign-in + Firestore sync" \
      "fix before pushing" \
      "live-app failure" \
      node scripts/verify-prod-signin.mjs
  else
    echo "pre-push: Chrome not found — skipping sign-in proof"
  fi
else
  [ -f scripts/verify-prod-signin.mjs ] || echo "pre-push: verify suite not present — skipping sign-in proof"
  [ -n "$KEY" ] || echo "pre-push: FIREBASE_WEB_API_KEY not set — skipping sign-in proof"
fi

# ── 3b. Profile no-email gate (needs Chrome) ───────────────────────────────
# Walks the deployed /reports + /settings pages as a signed-in throwaway user
# and asserts the removed UserProfile.email field never renders: no Email
# input/label in the Settings profile form, no stray Email label on /reports,
# no email-related console errors. Same Chrome + key requirements as gate 3;
# skips with a notice when either is missing.
if [ -n "$KEY" ] && [ -f scripts/verify-profile-no-email.mjs ]; then
  CHROME="${CHROME_PATH:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
  if [ -x "$CHROME" ]; then
    # The walkthrough drives the LIVE app with the same transient first-attempt
    # profile as gate 3 (sign-in network blips, slow page loads), so
    # run_with_retry retries ONCE after a 30s backoff before failing the push.
    run_with_retry 90 "profile no-email walkthrough" \
      "fix before pushing" \
      "live-app failure" \
      node scripts/verify-profile-no-email.mjs
  else
    echo "pre-push: Chrome not found — skipping profile no-email proof"
  fi
else
  [ -f scripts/verify-profile-no-email.mjs ] || echo "pre-push: verify suite not present — skipping profile no-email proof"
  [ -n "$KEY" ] || echo "pre-push: FIREBASE_WEB_API_KEY not set — skipping profile no-email proof"
fi

# ── 4. ship:ready final capstone gate (runs the FULL verify:all suite) ──────
# The one-command go-live verdict as the final gate: after every individual
# verifier above passes, run scripts/ship-ready.mjs — it asserts the working
# tree is clean (nothing staged, unstaged, or untracked — a dirty tree means
# the pushed/deployed commit cannot match the code you just ran) and then runs
# the full verify:all suite (all eleven §4 gates) against production, printing
# a single SHIP READY / SHIP BLOCKED verdict. Any nonzero exit aborts the
# push. Budget 1200s (20 min): ship:ready runs the WHOLE suite sequentially
# including the Chrome sign-in walkthroughs, far beyond the 90s per-verifier
# budget used above, so it is timeboxed separately. Always runs when the
# script file is present — no secret gates it, because verify:all's own gates
# skip-not-fail internally on missing secrets and the summary's REQUIRES
# column makes the skips visible.
if [ -f scripts/ship-ready.mjs ]; then    echo "pre-push: running final ship:ready verdict (clean tree + full verify:all suite)…"
  # Deliberately NOT run_with_retry: ship:ready's failures are never transient
  # (dirty tree, a verify:all gate failure) and it must FORWARD its own exit
  # code (1/2/3/142) so the caller sees the exact verdict — a retry wrapper
  # would collapse every failure to a bare 1. It still uses the shared timebox
  # for its 1200s budget.
  if timebox 1200 node scripts/ship-ready.mjs; then
    echo "pre-push: ship:ready passed ✓"
  else
    ship_rc=$?
    if [ "$ship_rc" -eq 142 ]; then
      echo "pre-push: ship:ready exceeded 1200s — too slow, run CI instead (SKIP_VERIFY_SIGNIN=1 to override)" >&2
    elif [ "$ship_rc" -eq 2 ]; then
      echo "pre-push: working tree is dirty — commit or stash before pushing (SKIP_VERIFY_SIGNIN=1 to override)" >&2
    else
      echo "pre-push: ship:ready FAILED (exit $ship_rc) — fix before pushing (SKIP_VERIFY_SIGNIN=1 to override)" >&2
    fi
    # Forward ship:ready's own exit code so the abort reason is visible in the
    # push's exit status instead of collapsing every failure to a bare 1: 1 =
    # a verify:all gate failed, 2 = working tree is dirty, 3 = git unusable,
    # 142 = the 1200s timebox fired. The caller (git push / ship:go) sees the
    # same code ship:ready printed in its SHIP BLOCKED verdict.
    exit $ship_rc
  fi
else
  echo "pre-push: verify suite not present — skipping ship:ready capstone"
fi

echo "pre-push: all applicable checks passed ✓"
